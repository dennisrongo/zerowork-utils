{
  "name": "Demo - X Feed Scraper",
  "table": {
    "name": "x_feed_posts",
    "columns": [
      "post_id",
      "author",
      "handle",
      "author_url",
      "post_text",
      "posted_at",
      "post_url",
      "replies",
      "reposts",
      "likes",
      "views",
      "has_media",
      "is_repost"
    ]
  },
  "nodes": [
    {"key": "delete", "type": "delete_table_data", "x": 320, "y": 0, "name": "Clear previous rows"},
    {"key": "launch", "type": "launch_browser", "x": 320, "y": 200, "name": "Launch Chrome (bypass)"},
    {"key": "open", "type": "open_link", "x": 320, "y": 400, "name": "Open X home"},
    {"key": "delay", "type": "sleep", "x": 320, "y": 600, "name": "Wait for timeline"},
    {"key": "try", "type": "try", "x": 320, "y": 800, "name": "Scrape scope"},
    {"key": "outer", "type": "loop", "x": 40, "y": 920, "name": "Scroll rounds"},
    {"key": "inner", "type": "loop", "x": 40, "y": 1140, "name": "Save visible tweets"},
    {"key": "save_url", "type": "save", "x": 40, "y": 1360, "name": "Save post URL"},
    {"key": "save_author", "type": "save", "x": 40, "y": 1540, "name": "Save author"},
    {"key": "save_text", "type": "save", "x": 40, "y": 1720, "name": "Save tweet text"},
    {"key": "save_time", "type": "save", "x": 40, "y": 1900, "name": "Save posted time"},
    {"key": "after_inner", "type": "continue_after_repeat", "x": 430, "y": 1140, "name": "After tweet loop"},
    {"key": "pagedown", "type": "keyboard", "x": 430, "y": 1360, "name": "Page down to load more"},
    {"key": "wait_new", "type": "sleep", "x": 430, "y": 1540, "name": "Wait for new tweets"},
    {"key": "catch", "type": "catch", "x": 700, "y": 1040, "name": "On scrape error"},
    {"key": "log_err", "type": "log", "x": 700, "y": 1260, "name": "Log scrape error"},
    {"key": "after_try", "type": "after_try", "x": 320, "y": 2100, "name": "After scrape"},
    {"key": "dedupe", "type": "remove_duplicate_rows", "x": 320, "y": 2280, "name": "Keep unique posts"},
    {"key": "log_ok", "type": "log", "x": 320, "y": 2460, "name": "Log scrape done"},
    {"key": "note_login", "type": "sticky_note", "x": -280, "y": 200, "name": "note_login"},
    {"key": "note_scroll", "type": "sticky_note", "x": 720, "y": 880, "name": "note_scroll"},
    {"key": "note_virtualizer", "type": "sticky_note", "x": 720, "y": 1500, "name": "note_virtualizer"}
  ],
  "edges": [
    ["delete", "launch"],
    ["launch", "open"],
    ["open", "delay"],
    ["delay", "try"],
    ["try", "outer"],
    ["outer", "inner"],
    ["inner", "save_url"],
    ["save_url", "save_author"],
    ["save_author", "save_text"],
    ["save_text", "save_time"],
    ["inner", "after_inner"],
    ["after_inner", "pagedown"],
    ["pagedown", "wait_new"],
    ["try", "catch"],
    ["catch", "log_err"],
    ["try", "after_try"],
    ["after_try", "dedupe"],
    ["dedupe", "log_ok"]
  ]
}
