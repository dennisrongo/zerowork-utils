{
  "name": "Demo - LinkedIn Feed Scraper",
  "table": {
    "name": "linkedin_feed_posts",
    "columns": [
      "post_urn",
      "author",
      "author_headline",
      "author_url",
      "post_text",
      "posted_at",
      "post_url",
      "reactions",
      "comments",
      "reposts",
      "has_media",
      "post_type"
    ]
  },
  "nodes": [
    {"key": "delete", "type": "delete_table_data", "x": 320, "y": 0, "name": "Clear previous rows"},
    {"key": "launch", "type": "launch_browser", "x": 320, "y": 200, "name": "Launch Chrome (bypass)"},
    {"key": "open", "type": "open_link", "x": 320, "y": 400, "name": "Open LinkedIn feed"},
    {"key": "delay", "type": "sleep", "x": 320, "y": 600, "name": "Wait for feed"},
    {"key": "try", "type": "try", "x": 320, "y": 800, "name": "Scrape scope"},
    {"key": "js", "type": "write_js", "x": 320, "y": 1040, "name": "Harvest visible posts"},
    {"key": "catch", "type": "catch", "x": 700, "y": 1040, "name": "On scrape error"},
    {"key": "log_err", "type": "log", "x": 700, "y": 1260, "name": "Log scrape error"},
    {"key": "after_try", "type": "after_try", "x": 320, "y": 1260, "name": "After scrape"},
    {"key": "dedupe", "type": "remove_duplicate_rows", "x": 320, "y": 1480, "name": "Keep unique posts"},
    {"key": "log_ok", "type": "log", "x": 320, "y": 1700, "name": "Log scrape done"},
    {"key": "note_login", "type": "sticky_note", "x": -280, "y": 200, "name": "note_login"}
  ],
  "edges": [
    ["delete", "launch"],
    ["launch", "open"],
    ["open", "delay"],
    ["delay", "try"],
    ["try", "js"],
    ["try", "catch"],
    ["catch", "log_err"],
    ["try", "after_try"],
    ["after_try", "dedupe"],
    ["dedupe", "log_ok"]
  ]
}
